{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./app/*"]
    }
  },
  "include": [
    "worker.ts",
    "worker/**/*.ts",
    "app/lib/slug.ts",
    "app/types/admin.ts"
  ]
}
