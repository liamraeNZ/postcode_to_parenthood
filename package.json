{
  "name": "fertilityfund",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "./run-dev.sh",
    "dev:vite": "vite --port=3005 --host=0.0.0.0",
    "dev:worker": "npx wrangler dev --port 8788 --local",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "deploy": "npx wrangler deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "cf:migrate:local": "npx wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "npx wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.3.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260407.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "^4.84.0"
  }
}
