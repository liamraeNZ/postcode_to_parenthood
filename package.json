    "test": "vitest run",
    "test:watch": "vitest",
    "cf:migrate:local": "npx wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "npx wrangler d1 migrations apply DB --remote",
    "fetch-boundaries": "npx tsx scripts/fetch-icb-boundaries.ts",
    "generate-ons-ods": "npx tsx scripts/generate-ons-ods-mapping.ts"
