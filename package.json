    "deploy:full": "npm run build && npx wrangler deploy && ./scripts/upload-boundaries-to-r2.sh",
    "upload-boundaries": "./scripts/upload-boundaries-to-r2.sh",
    "preview": "wrangler dev",
    "clean": "rm -rf build",
