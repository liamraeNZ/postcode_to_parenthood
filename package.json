{
  "name": "fertilityfund",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "./run-dev.sh",
    "dev:frontend": "npm run -w frontend dev",
    "dev:backend": "npm run -w backend dev",
    "build": "npm run -w frontend build && npm run -w backend build",
    "build:backend": "npm run -w backend build",
    "deploy:backend": "npm run -w backend deploy",
    "preview": "npm run -w frontend preview",
    "lint": "npm run -w frontend lint && npm run -w backend lint",
    "cf:migrate:local": "npm run -w backend migrate:local",
    "cf:migrate:remote": "npm run -w backend migrate:remote"
  },
  "devDependencies": {}
}
